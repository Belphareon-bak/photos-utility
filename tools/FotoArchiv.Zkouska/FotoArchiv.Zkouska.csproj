<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Konzolova zkouska jadra FotoArchivu bez WPF - bezi na Windows i na Linuxu.
    Prelozi primo zdrojove soubory jadra z FotoArchiv.App (ne kopie), krome
    ThumbnailService.cs, ktery jako jediny zavisi na WPF.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FotoArchiv.Zkouska</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup><Jadro>../../FotoArchiv.App</Jadro></PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Jadro)/Services/*.cs" Exclude="$(Jadro)/Services/ThumbnailService.cs" LinkBase="Jadro/Services" />
    <Compile Include="$(Jadro)/Models/*.cs" LinkBase="Jadro/Models" />
    <Compile Include="$(Jadro)/Common/ObservableObject.cs" LinkBase="Jadro/Common" />
    <Compile Include="$(Jadro)/GlobalUsings.cs" LinkBase="Jadro" />
    <None Include="$(Jadro)/Data/**" LinkBase="Data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>
</Project>
